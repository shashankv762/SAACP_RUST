/target
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
*.log
*.sentinel
!tests/fixtures/*.sentinel

# Dev-only benchmark artifacts (regenerable, not source)
benches_output.txt
*.bak

# Python bytecode cache (python/saacp_client package)
__pycache__/
*.pyc
*.egg-info/
opusplan.md
opusplan2.md
_TEMP_impl_plan.md
imp_plan*

# Append-only manifest written by scripts/prune_test_results.py — a log of
# pruned/trimmed test-result files, not a build artifact, but regenerated
# indefinitely so it doesn't belong in version control.
/.test-manifest.jsonl

# Local agent/dev tooling and machine-specific config — not part of the project.
# .cargo/config.toml pins a machine-specific RAM-disk target dir (R:/...), and
# .claude/.agents hold local assistant settings; none belong in the public repo.
/.claude/
/.agents/
/.cargo/
/scripts/
/.tmp-target-build/

# Local working/analysis docs and tooling state (same class as opusplan/imp_plan
# above): the kimiplan assessment is responded to normatively in
# KIMIPLAN_RESPONSE.md, which quotes what it needs.
/kimiplan
/.zcode/
/.rbxsync-trash/

# Benchmark run artifacts (regenerable from `cargo bench`) — the curated,
# human-readable results live in benchmark_results.md instead.
/bench_raw_output.txt
/bench_parsed.txt
