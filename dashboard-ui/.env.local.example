# Copy to .env.local and fill in.

# Base URL of the running saacp-command-center backend (src/command_center.rs).
NEXT_PUBLIC_API_BASE=http://127.0.0.1:9090

# Hex encoding of the SAME 32-byte SAACP_DASHBOARD_TOKEN the backend was started with.
# e.g. if you started the backend with SAACP_DASHBOARD_TOKEN=<base64>, run:
#   python -c "import base64;print(base64.b64decode('<base64>').hex())"
# or, from the repo root:
#   cargo run --bin saacp-command-center   # prints nothing sensitive, but see its
#                                           # own env docs for how the token is read
NEXT_PUBLIC_DASHBOARD_TOKEN=
